# Copy to .env.development.local (never commit it).

# The UI can be built without a backend: in development API calls are off unless this is true.
VITE_USE_API=true

# Sign in without Telegram against a local backend started with DEV_AUTH=true (development only; ignored in production builds).
VITE_DEV_TG_ID=1001

# Where the dev server forwards /api (the v4 backend). Default: http://localhost:8080
# VITE_BACKEND=http://localhost:8080

# Production build: the API address when it is not served from the same domain as the app (needs CORS_ORIGINS on the API).
# VITE_API_URL=https://api.example.com/api

# Sent as X-App-Version; raise the server's app.min_version to make older apps reload.
# VITE_APP_VERSION=1.0.0
